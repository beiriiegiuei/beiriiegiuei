generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 작품 (하나의 세계관 단위)
model Project {
  id         String   @id @default(cuid())
  title      String
  logline    String? // 한 줄 소개
  genre      String?
  coverEmoji String?  @default("📖")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  characters       Character[]
  relationships    Relationship[]
  foreshadows      Foreshadow[]
  seasons          Season[]
  acts             Act[]
  scenes           Scene[]
  wikiPages        WikiPage[]
  factions         Faction[]
  factionRelations FactionRelation[]
}

// 등장인물
model Character {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  aliases     String? // 이명 / 가명 (예: 케이가스, 마시야마 타이요우)
  role        String? // 주인공 / 조연 / 악역 / 단역 ...
  emoji       String?  @default("🧑")
  color       String?  @default("#7c54f5")
  summary     String? // 한 줄 요약
  age         String?
  gender      String?
  mbti        String?
  element     String? // 속성 / 능력 계열 (예: 검류, 전기, 추위)
  rank        Int? // 랭킹 (숫자, 작을수록 강함)
  tier        String? // 등급 (예: 초급/중급/상급 월성)
  lifeStatus  String?  @default("alive") // alive | dead | revived | unknown
  tags        String? // 쉼표 구분 태그
  factionId   String? // 소속 세력
  faction     Faction? @relation("factionMembers", fields: [factionId], references: [id], onDelete: SetNull)
  appearance  String?
  personality String?
  background  String? // 서사 / 과거
  goal        String? // 목표 / 동기
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  relationsFrom Relationship[] @relation("from")
  relationsTo   Relationship[] @relation("to")
  ledFactions   Faction[]      @relation("factionLeader")

  @@index([projectId])
  @@index([factionId])
}

// 인물 간 관계 (방향성 있음)
model Relationship {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromId      String
  toId        String
  from        Character @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to          Character @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  label       String? // "연인", "라이벌", "스승" ...
  kind        String?   @default("neutral") // ally | rival | family | romance | neutral
  description String?

  @@index([projectId])
}

// 세력 / 조직 (예: 15정각, 네버피스)
model Faction {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  element     String? // 세력 속성 (예: 검류, 전기)
  emoji       String?  @default("⚔️")
  color       String?  @default("#7c54f5")
  summary     String?
  description String?
  leaderId    String? // 수장 / 각주
  leader      Character? @relation("factionLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  parentId    String? // 상위 세력 (산하 구조)
  parent      Faction?  @relation("factionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Faction[] @relation("factionTree")
  members     Character[] @relation("factionMembers")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  relFrom FactionRelation[] @relation("frelFrom")
  relTo   FactionRelation[] @relation("frelTo")

  @@index([projectId])
}

// 세력 간 관계
model FactionRelation {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromId      String
  toId        String
  from        Faction @relation("frelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          Faction @relation("frelTo", fields: [toId], references: [id], onDelete: Cascade)
  label       String?
  kind        String? @default("neutral") // ally | rival | subordinate | neutral
  description String?

  @@index([projectId])
}

// 떡밥 (복선)
model Foreshadow {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  importance      Int      @default(2) // 1=낮음 2=보통 3=핵심
  status          String   @default("planted") // planted | resolved | abandoned
  plantedSceneId  String? // 심은 회차
  resolvedSceneId String? // 회수 회차
  createdAt       DateTime @default(now())

  @@index([projectId])
}

// 시즌 (스토리 최상위 묶음)
model Season {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  order     Int     @default(0)
  acts      Act[]

  @@index([projectId])
}

// 아크 / 시나리오 (시즌 하위, 회차 묶음)
model Act {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seasonId  String?
  season    Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  title     String
  summary   String?
  epStart   Int? // 시작 회차
  epEnd     Int? // 끝 회차
  order     Int     @default(0)
  scenes    Scene[]

  @@index([projectId])
  @@index([seasonId])
}

// 회차 / 장면 (콘티 카드)
model Scene {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actId     String?
  act       Act?    @relation(fields: [actId], references: [id], onDelete: SetNull)
  title     String
  summary   String?
  episodeNo Int? // 회차 번호
  status    String? @default("idea") // idea | draft | done
  order     Int     @default(0)

  @@index([projectId])
  @@index([actId])
}

// 세계관 위키 문서
model WikiPage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  category  String?  @default("일반")
  content   String? // 마크다운 + [[백링크]]
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ─────────────────────────────────────────────
// 대화형 스토리 ("톡스토리") — 채티류 읽기/쓰기 공간
// ─────────────────────────────────────────────

// 이용자 (읽기·쓰기 모두 로그인 필요)
model User {
  id           String   @id @default(cuid())
  username     String   @unique // 로그인 아이디 (소문자)
  displayName  String // 화면에 보이는 필명
  passwordHash String // scrypt 해시 (salt 포함)
  createdAt    DateTime @default(now())

  stories  TalkStory[]
  likes    StoryLike[]
  comments StoryComment[]
  reads    StoryRead[]
}

// 한 편의 작품 (여러 '화'를 묶는 단위)
model TalkStory {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String? // 소개글
  coverEmoji  String?  @default("💬")
  genre       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters TalkCharacter[] // 인물은 작품 단위로 공유 (모든 화에서 재사용)
  episodes   TalkEpisode[]

  @@index([authorId])
}

// 화 (회차) — 실제 대화·조회수·댓글이 달리는 단위
model TalkEpisode {
  id        String   @id @default(cuid())
  storyId   String
  story     TalkStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  title     String // 예: "1화", "프롤로그"
  number    Int      @default(1) // 회차 순서
  published Boolean  @default(false) // 개시(공개) 여부
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TalkMessage[]
  likes    StoryLike[]
  comments StoryComment[]
  reads    StoryRead[]

  @@index([storyId, number])
  @@index([published, updatedAt])
}

// 작품에 등장하는 화자 (말풍선 주인). 색이 아니라 프로필(이모지/사진)로 구분.
model TalkCharacter {
  id      String  @id @default(cuid())
  storyId String
  story   TalkStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  name    String
  emoji   String? @default("🙂") // 기본 프로필 (사진이 없을 때)
  avatar  String? // 업로드한 프로필 사진 (data URL). 있으면 emoji 대신 사용
  align   String  @default("left") // left | right (오른쪽 = '나'/주인공)
  order   Int     @default(0)

  messages TalkMessage[]

  @@index([storyId])
}

// 대화 한 줄 (말풍선 또는 지문)
model TalkMessage {
  id          String   @id @default(cuid())
  episodeId   String
  episode     TalkEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  characterId String? // 지문/나레이션은 화자 없음
  character   TalkCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  kind        String   @default("dialogue") // dialogue | thought | monologue | narration
  text        String
  order       Int      @default(0)

  @@index([episodeId])
}

// 좋아요 (이용자 × 화, 중복 방지)
model StoryLike {
  id        String   @id @default(cuid())
  episodeId String
  episode   TalkEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([episodeId, userId])
  @@index([episodeId])
}

// 댓글
model StoryComment {
  id        String   @id @default(cuid())
  episodeId String
  episode   TalkEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([episodeId])
}

// 열람 기록 — 조회수를 '탭 합계'가 아니라 '연 사람 수 + 완독률'로 집계
model StoryRead {
  id        String   @id @default(cuid())
  episodeId String
  episode   TalkEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxIndex  Int      @default(0) // 도달한 최대 위치
  completed Boolean  @default(false) // 끝까지 읽었는지
  updatedAt DateTime @updatedAt

  @@unique([episodeId, userId])
  @@index([episodeId])
}
