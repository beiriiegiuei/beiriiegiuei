# 이 파일을 .env 로 복사해서 사용하세요: cp .env.example .env
#
# 클라우드 DB(Neon 등 PostgreSQL)의 연결 문자열을 넣으세요.
# Neon 대시보드 > Connection string 에서 복사 (sslmode=require 포함)
# 예: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# 톡스토리 로그인 세션 서명용 비밀키 (배포 시 반드시 무작위 문자열로 설정)
# 예: openssl rand -hex 32 로 생성
AUTH_SECRET="change-me-to-a-long-random-string"
